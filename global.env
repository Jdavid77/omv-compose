# Compose reads this file for every stack. It's committed, so keep secrets out of it.
#
# The stacks reference the appdata shared folder as ${APPDATA} because the plugin's own
# placeholders, ${{ sf:"appdata" }} and CHANGE_TO_COMPOSE_DATA_PATH, are only replaced in files
# saved from its editor. Files pulled from git reach Compose unchanged, and Up fails.
APPDATA=/srv/dev-disk-by-uuid-ff763355-7fef-41fe-b2d7-6d368a3b4313/docker/appdata
